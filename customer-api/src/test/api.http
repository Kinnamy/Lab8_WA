@baseUrl = http://localhost:8080/api/customers
@contentType = application/json

### ==========================================
### Test 1: GET All Customers
### Expected: 200 OK (List containing John Doe)
### ==========================================
GET {{baseUrl}}

### ==========================================
### Test 2: GET Customer by ID
### Note: If John Doe was the first customer, ID is 1.
### ==========================================
GET {{baseUrl}}/1

### ==========================================
### Test 3: POST Create Customer (David Miller)
### Expected: 201 Created
### ==========================================
# @name createDavid
POST {{baseUrl}}
Content-Type: {{contentType}}

{
    "customerCode": "C006",
    "fullName": "David Miller",
    "email": "david.miller@example.com",
    "phone": "+15550106000",
    "address": "999 Broadway, Seattle, WA 98101"
}

### ==========================================
### Test 4: PUT Update Customer
### Note: We use the ID from the previous request (@createDavid)
### If that fails, manually replace {{createDavid.response.body.id}} with the ID you see (e.g., 2)
### ==========================================
PUT {{baseUrl}}/{{createDavid.response.body.id}}
Content-Type: {{contentType}}

{
    "customerCode": "C006",
    "fullName": "David Miller Jr.",
    "email": "david.miller.jr@example.com",
    "phone": "+15550107000",
    "address": "1000 Broadway, Seattle, WA 98101"
}

### ==========================================
### Test 5: DELETE Customer
### Note: Deleting the David Miller account we just made
### ==========================================
DELETE {{baseUrl}}/{{createDavid.response.body.id}}

### ==========================================
### Test 6: Search Customers
### Expected: 200 OK (Should find John Doe)
### ==========================================
GET {{baseUrl}}/search?keyword=john

### ==========================================
### Test 7: Validation Error
### Expected: 400 Bad Request (Invalid Code, Email, etc)
### ==========================================
POST {{baseUrl}}
Content-Type: {{contentType}}

{
    "customerCode": "C",
    "email": "invalid-email"
}

### ==========================================
### Test 8: Resource Not Found
### Expected: 404 Not Found
### ==========================================
GET {{baseUrl}}/999

### ==========================================
### Test 9: Duplicate Resource
### Expected: 409 Conflict (Email john.doe already exists)
### ==========================================
POST {{baseUrl}}
Content-Type: {{contentType}}

{
    "customerCode": "C001",
    "fullName": "John Doe",
    "email": "john.doe@example.com",
    "phone": "+1555010100", 
    "address": "123 Main St, New York, NY 10001"
}